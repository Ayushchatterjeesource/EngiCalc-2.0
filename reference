<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Engineering Constants - EngiCalc 2.0</title>
<style>
*{box-sizing:border-box}body{font-family:Arial;background:#f5f7fb;margin:0;color:#172033}
header{background:#111827;color:white;text-align:center;padding:18px}header a{color:white;text-decoration:none}
header img{width:50px;vertical-align:middle}
.container{max-width:900px;margin:25px auto;padding:15px}
.card{background:white;padding:20px;border-radius:18px;box-shadow:0 5px 20px #0001;margin-bottom:15px}
table{width:100%;border-collapse:collapse}th,td{padding:13px;border-bottom:1px solid #ddd;text-align:left}
th{background:#eff6ff;color:#2563eb}
.search{width:100%;padding:13px;border:1px solid #ddd;border-radius:10px;margin-bottom:20px;font-size:16px}
@media(max-width:600px){table{font-size:14px}th,td{padding:9px}}
</style>
</head>
<body>

<header>
<a href="../index.html">
<img src="../engicalc2.0-logo.png">
<b>EngiCalc 2.0</b>
</a>
</header>

<div class="container">
<div class="card">
<h2>Engineering Constants</h2>

<input class="search" id="search" placeholder="Search constants..." onkeyup="searchTable()">

<table id="table">
<thead>
<tr>
<th>Constant</th>
<th>Symbol</th>
<th>Value</th>
<th>Unit</th>
</tr>
</thead>

<tbody>
<tr><td>Acceleration due to gravity</td><td>g</td><td>9.80665</td><td>m/s²</td></tr>
<tr><td>Speed of light</td><td>c</td><td>299792458</td><td>m/s</td></tr>
<tr><td>Gravitational constant</td><td>G</td><td>6.67430 × 10⁻¹¹</td><td>N·m²/kg²</td></tr>
<tr><td>Planck constant</td><td>h</td><td>6.62607015 × 10⁻³⁴</td><td>J·s</td></tr>
<tr><td>Elementary charge</td><td>e</td><td>1.602176634 × 10⁻¹⁹</td><td>C</td></tr>
<tr><td>Vacuum permittivity</td><td>ε₀</td><td>8.8541878128 × 10⁻¹²</td><td>F/m</td></tr>
<tr><td>Vacuum permeability</td><td>μ₀</td><td>1.25663706212 × 10⁻⁶</td><td>H/m</td></tr>
<tr><td>Avogadro constant</td><td>Nₐ</td><td>6.02214076 × 10²³</td><td>mol⁻¹</td></tr>
<tr><td>Boltzmann constant</td><td>k</td><td>1.380649 × 10⁻²³</td><td>J/K</td></tr>
<tr><td>Gas constant</td><td>R</td><td>8.314462618</td><td>J/(mol·K)</td></tr>
<tr><td>Standard atmospheric pressure</td><td>Pₐₜₘ</td><td>101325</td><td>Pa</td></tr>
<tr><td>Water density</td><td>ρ</td><td>1000</td><td>kg/m³</td></tr>
<tr><td>Electron mass</td><td>mₑ</td><td>9.1093837 × 10⁻³¹</td><td>kg</td></tr>
<tr><td>Proton mass</td><td>mₚ</td><td>1.6726219 × 10⁻²⁷</td><td>kg</td></tr>
</tbody>
</table>
</div>
</div>

<script>
function searchTable(){
let q=document.getElementById("search").value.toLowerCase();
document.querySelectorAll("#table tbody tr").forEach(row=>{
row.style.display=row.innerText.toLowerCase().includes(q)?"":"none";
});
}
</script>
</body>
</html>
